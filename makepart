
let partRenderer,partScene,partCamera,partControls,partObject,partSpin=false,partWire=false,partStarted=false;
function makePart(shape){
 const g=new THREE.Group();
 const mat=(c,m=.55,r=.32)=>new THREE.MeshStandardMaterial({color:c,metalness:m,roughness:r});
 const steel=mat(0x9aa8b2),dark=mat(0x293744),orange=mat(0xff8735,.45),black=mat(0x101820),blue=mat(0x4e8299,.4);
 function add(geo,m,x=0,y=0,z=0,rx=0,ry=0,rz=0){
  let o=new THREE.Mesh(geo,m);o.position.set(x,y,z);o.rotation.set(rx,ry,rz);g.add(o);return o
 }
 function cyl(rt,rb,h,m,x=0,y=0,z=0,axis='y'){
  return add(new THREE.CylinderGeometry(rt,rb,h,40),m,x,y,z,axis==='z'?Math.PI/2:0,0,0)
 }
 switch(shape){
 case'block':add(new THREE.BoxGeometry(2.6,1.15,1.5),dark);for(let x of [-.82,-.27,.27,.82])for(let z of [-.42,.42])cyl(.19,.19,1.2,steel,x,.08,z);break;
 case'sleeve':cyl(.62,.62,1.7,steel);cyl(.43,.43,1.72,black);break;
 case'piston':cyl(.58,.58,.2,steel,0,.62,0);cyl(.49,.49,.9,steel,0,.12,0);for(let y of [.35,.47,.59]){let t=new THREE.Mesh(new THREE.TorusGeometry(.5,.035,8,48),orange);t.position.y=y;g.add(t)}break;
 case'rings':for(let y of [-.28,-.08,.12]){let t=new THREE.Mesh(new THREE.TorusGeometry(.62,.035,8,64),steel);t.position.y=y;g.add(t)}break;
 case'rod':cyl(.27,.27,.24,steel,-.52,.35,0);cyl(.19,.19,.24,steel,.58,-.35,0);let bar=add(new THREE.BoxGeometry(.28,1.15,.18),steel,0,0,0,0,0,-.55);break;
 case'crank':for(let x of [-.9,-.3,.3,.9]){cyl(.22,.22,1.1,steel,x,0,0,'z');add(new THREE.BoxGeometry(.35,.85,.3),dark,x,.25,0)}cyl(.16,.16,3.2,orange,0,0,0,'x');break;
 case'head':add(new THREE.BoxGeometry(2.3,.55,1.5),steel);for(let x of [-.7,-.23,.23,.7])for(let z of [-.38,.38])cyl(.16,.16,.3,orange,x,-.4,z);break;
 case'valve':cyl(.18,.18,1.4,steel,0,.2,0);cyl(.43,.43,.12,orange,0,-.55,0);break;
 case'spring':{let pts=[];for(let i=0;i<=180;i++){let a=i/180*Math.PI*12;pts.push(new THREE.Vector3(.35*Math.cos(a),-.8+i/180*1.6,.35*Math.sin(a)))}let curve=new THREE.CatmullRomCurve3(pts);add(new THREE.TubeGeometry(curve,220,.035,8,false),orange);break}
 case'cam':cyl(.17,.17,2.4,steel,0,0,0,'x');for(let x of [-.8,-.3,.3,.8]){let o=add(new THREE.SphereGeometry(.27,24,16),orange,x,.2,0);o.scale.set(.7,1.4,.8)}break;
 case'gasket':add(new THREE.BoxGeometry(2.1,.08,1.3),steel);for(let x of [-.7,-.23,.23,.7])for(let z of [-.4,.4])cyl(.14,.14,.1,black,x,.06,z);break;
 case'stud':cyl(.12,.12,1.6,steel);cyl(.23,.23,.18,orange,0,.83,0);break;
 case'spark':cyl(.12,.12,1.1,steel);cyl(.21,.21,.3,blue,0,.65,0);cyl(.08,.08,.32,orange,0,-.65,0);break;
 case'coil':cyl(.32,.32,.9,black);cyl(.23,.23,.3,orange,0,.58,0);break;
 case'turbo':{let a=cyl(.58,.58,.55,steel,0,0,0,'z');let b=cyl(.36,.36,.42,orange,.65,0,0,'z');add(new THREE.TorusGeometry(.58,.07,12,48),dark,0,0,.3);break}
 case'supercharger':cyl(.75,.75,.55,steel,0,0,0,'z');cyl(.3,.3,.75,orange,.55,0,0,'z');break;
 case'intercooler':add(new THREE.BoxGeometry(1.8,1.05,.45),dark);for(let y=-.38;y<=.39;y+=.13)add(new THREE.BoxGeometry(1.65,.035,.48),orange,0,y,0);break;
 case'manifold':{let trunk=cyl(.16,.16,1.8,orange,0,-.2,0,'x');for(let x of [-.65,-.2,.2,.65]){let t=add(new THREE.CylinderGeometry(.1,.1,.8,20),steel,x,.45,0,0,0,(x*.3));}break}
 case'radiator':add(new THREE.BoxGeometry(1.7,1.3,.28),dark);for(let x=-.7;x<=.71;x+=.12)add(new THREE.BoxGeometry(.025,1.15,.3),orange,x,0,0);break;
 case'tank':add(new THREE.CapsuleGeometry(.55,.95,8,20),steel,0,0,0,0,0,Math.PI/2);break;
 case'pump':cyl(.43,.43,.85,steel,0,0,0,'z');cyl(.2,.2,.25,orange,0,0,.5,'z');break;
 case'injector':cyl(.16,.16,1.15,steel);cyl(.28,.28,.22,orange,0,.58,0);break;
 case'motor':cyl(.65,.65,1.3,steel,0,0,0,'z');cyl(.23,.23,1.65,orange,0,0,0,'z');add(new THREE.TorusGeometry(.67,.07,10,48),dark,0,0,.45);break;
 case'battery':add(new THREE.BoxGeometry(1.8,.65,1.1),dark);for(let x of [-.6,-.2,.2,.6])add(new THREE.BoxGeometry(.27,.42,.8),steel,x,.5,0);break;
 case'inverter':add(new THREE.BoxGeometry(1.5,.65,1),dark);for(let x of [-.4,0,.4])cyl(.12,.12,.3,orange,x,.45,0);break;
 case'gearbox':cyl(.72,.72,1.5,steel,0,0,0,'z');for(let x of [-.35,.35]){let t=new THREE.Mesh(new THREE.TorusGeometry(.35,.12,12,32),orange);t.position.set(x,0,.3);g.add(t)}break;
 case'converter':cyl(.78,.78,.42,steel,0,0,0,'z');add(new THREE.TorusGeometry(.5,.16,12,40),orange,0,0,.1);break;
 case'diff':cyl(.72,.72,.65,steel,0,0,0,'z');for(let x of [-.85,.85])cyl(.12,.12,.7,orange,x,0,0,'x');break;
 case'shaft':cyl(.12,.12,2.7,steel,0,0,0,'x');for(let x of [-1.25,1.25])cyl(.25,.25,.25,orange,x,0,0,'x');break;
 case'steering':cyl(.12,.12,1.9,steel,0,0,0,'x');for(let x of [-.85,.85])cyl(.19,.19,.45,orange,x,0,0,'x');break;
 case'damper':cyl(.22,.22,1.55,steel);cyl(.36,.36,.48,orange,0,-.25,0);cyl(.12,.12,.5,dark,0,.95,0);break;
 case'air':cyl(.38,.38,.5,black,0,-.3,0);cyl(.42,.42,.7,blue,0,.1,0);cyl(.18,.18,.65,steel,0,.78,0);break;
 case'arm':{let a=add(new THREE.BoxGeometry(.22,1.65,.2),steel,0,0,0,0,0,-.7);cyl(.25,.25,.24,orange,-.55,.6,0,'z');cyl(.25,.25,.24,orange,.55,-.6,0,'z');break}
 case'hub':cyl(.55,.55,.35,steel,0,0,0,'z');cyl(.3,.3,.6,orange,0,0,.3,'z');for(let i=0;i<5;i++){let a=i*Math.PI*2/5;cyl(.07,.07,.18,dark,.38*Math.cos(a),.38*Math.sin(a),.25,'z')}break;
 case'disc':cyl(.8,.8,.12,steel,0,0,0,'z');cyl(.35,.35,.15,dark,0,0,.02,'z');for(let i=0;i<12;i++){let a=i*Math.PI/6;let h=add(new THREE.BoxGeometry(.05,.28,.04),orange,.58*Math.cos(a),.58*Math.sin(a),.08);h.rotation.z=a}break;
 case'pad':add(new THREE.BoxGeometry(.9,.18,.65),dark);add(new THREE.BoxGeometry(.78,.07,.55),orange,0,-.13,0);break;
 case'monocoque':add(new THREE.BoxGeometry(2.2,.45,1.3),dark);add(new THREE.BoxGeometry(1.1,.65,1.1),steel,0,.45,0);for(let x of [-.9,.9])add(new THREE.BoxGeometry(.16,.75,1.35),orange,x,.2,0);break;
 case'wheel':{let t=new THREE.Mesh(new THREE.TorusGeometry(.67,.22,16,48),black);g.add(t);cyl(.38,.38,.22,steel,0,0,0,'z');for(let i=0;i<8;i++){let a=i*Math.PI/4;let sp=add(new THREE.BoxGeometry(.08,.62,.08),orange,.0,.0,0);sp.position.set(.3*Math.cos(a),.3*Math.sin(a),.13);sp.rotation.z=a}break}
 default:add(new THREE.BoxGeometry(1,1,1),orange)}
 return g;
}
window.showPartModel=function(shape){
 const host=document.getElementById('partViewer');
 if(!partStarted){
  partStarted=true;
  document.getElementById('partFallback').style.display='none';
  partScene=new THREE.Scene();
  partScene.background=new THREE.Color(0x0b121a);
  partCamera=new THREE.PerspectiveCamera(42,host.clientWidth/host.clientHeight,.1,100);
  partCamera.position.set(3.8,2.7,4.8);
  partRenderer=new THREE.WebGLRenderer({antialias:true});
  partRenderer.setPixelRatio(Math.min(devicePixelRatio,2));
  partRenderer.setSize(host.clientWidth,host.clientHeight);
  host.appendChild(partRenderer.domElement);
  partControls=new OrbitControls(partCamera,partRenderer.domElement);
  partControls.enableDamping=true;
  partScene.add(new THREE.HemisphereLight(0xc7e2ff,0x1a2028,2));
  let l=new THREE.DirectionalLight(0xffffff,3);
  l.position.set(4,6,5);partScene.add(l);
  let o=new THREE.PointLight(0xff8735,15,10);
  o.position.set(-3,2,-3);partScene.add(o);
  let grid=new THREE.GridHelper(8,20,0x33404b,0x202a34);
  grid.position.y=-1.2;partScene.add(grid);
  function anim(){
   requestAnimationFrame(anim);
   if(partObject&&partSpin)partObject.rotation.y+=.004;
   partControls.update();
   partRenderer.render(partScene,partCamera)
  }
  anim();
  new ResizeObserver(()=>{
   partCamera.aspect=host.clientWidth/host.clientHeight;
   partCamera.updateProjectionMatrix();
   partRenderer.setSize(host.clientWidth,host.clientHeight)
  }).observe(host)
 }
 if(partObject)partScene.remove(partObject);
 partObject=makePart(shape);
 partScene.add(partObject);
 partCamera.position.set(3.8,2.7,4.8);
 partControls.target.set(0,0,0);
 partControls.update();
}
document.getElementById('partReset').onclick=()=>{
 if(!partCamera)return;
 partCamera.position.set(3.8,2.7,4.8);
 partControls.target.set(0,0,0);
 partControls.update();
 if(partObject)partObject.rotation.set(0,0,0)
};
document.getElementById('partSpin').onclick=e=>{
 partSpin=!partSpin;
 e.target.textContent='Автоповорот: '+(partSpin?'вкл.':'выкл.')
};
document.getElementById('partWire').onclick=e=>{
 partWire=!partWire;
 if(partObject)partObject.traverse(o=>{
  if(o.isMesh)o.material.wireframe=partWire
 });
 e.target.textContent='Каркас: '+(partWire?'вкл.':'выкл.')
};
